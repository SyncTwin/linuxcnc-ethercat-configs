# IEC: TOF (off-delay). HAL: timedelay, параметр off-delay
# Ожидание: после снятия входа out держится ещё ~0.5 с
loadrt threads name1=t period1=1000000
loadrt timedelay count=1
addf timedelay.0 t
setp timedelay.0.on-delay 0
setp timedelay.0.off-delay 0.5
start
setp timedelay.0.in 1
loadusr -w sleep 0.2
setp timedelay.0.in 0
loadusr -w sleep 0.2
show pin timedelay
loadusr -w sleep 0.5
show pin timedelay

# CODESYS: HYSTERESIS / компаратор с зоной нечувствительности. HAL: comp
# ⚠ in0 — ИНВЕРТИРУЮЩИЙ вход: out истинен, когда in1 > in0. Первая редакция
# кейса ставила измеряемую величину в in0, а порог в in1 — и выход был ИСТИНЕН,
# пока момент НИЖЕ порога, то есть ровно наоборот замыслу «зажать до упора».
# Поймано прогоном 21.08: при 0.30 выход TRUE, при 0.42 — FALSE.
# Порог кладём в in0, измеряемое — в in1.
# Ожидание: 0.30 → FALSE (ещё едем), 0.42 → TRUE (зажали).
loadrt threads name1=t period1=1000000
loadrt comp count=1
addf comp.0 t
setp comp.0.hyst 0.05
setp comp.0.in0 0.35          # порог 35 % номинального момента
start
setp comp.0.in1 0.30          # текущий момент — ниже порога
loadusr -w sleep 0.1
show pin comp
setp comp.0.in1 0.42          # момент вырос — упор
loadusr -w sleep 0.1
show pin comp

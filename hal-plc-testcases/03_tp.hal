# IEC: TP (pulse timer). HAL: oneshot
# Ожидание: импульс заданной длины независимо от длительности входа
loadrt threads name1=t period1=1000000
loadrt oneshot count=1
addf oneshot.0 t
setp oneshot.0.width 0.4
setp oneshot.0.rising 1
start
setp oneshot.0.in 1
loadusr -w sleep 0.05
setp oneshot.0.in 0
loadusr -w sleep 0.2
show pin oneshot
loadusr -w sleep 0.4
show pin oneshot

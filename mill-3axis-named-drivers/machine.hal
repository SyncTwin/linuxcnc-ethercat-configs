# Generated by AICNC mill-is620n machine constructor
# Hardware: IS620N-XYZ, 3 real EtherCAT axes (XYZ), 0 virtual

loadrt [KINS]KINEMATICS
loadrt [EMCMOT]EMCMOT servo_period_nsec=[EMCMOT]SERVO_PERIOD num_joints=[KINS]JOINTS

# Load EtherCAT master + config
loadusr -W lcec_conf ethercat-conf.xml
loadrt lcec

# Load CIA402 (one slave per real axis, + 1 for the spindle inverter)
loadrt cia402 count=4

# Telemetry sampler — smooth live twin from REAL drive feedback
loadrt sampler depth=3500 cfg=sssussssussssus
# channels 3, 8, 13 are u32: the cia402 class exports
# srv-actual-following-error as u32, unlike our old hand-written s32 pin.

# Threads
addf lcec.read-all servo-thread
addf cia402.0.read-all servo-thread
addf cia402.1.read-all servo-thread
addf cia402.2.read-all servo-thread
addf cia402.3.read-all servo-thread
addf motion-command-handler servo-thread
addf motion-controller servo-thread
addf sampler.0 servo-thread
addf cia402.0.write-all servo-thread
addf cia402.1.write-all servo-thread
addf cia402.2.write-all servo-thread
addf cia402.3.write-all servo-thread
addf lcec.write-all servo-thread

# *** AXIS X (Real IS620N — joint 0, cia402 0, EtherCAT slave 0) ***

# Joint signals
net x-pos-cmd <= joint.0.motor-pos-cmd
net x-pos-fb => joint.0.motor-pos-fb
net x-enable <= joint.0.amp-enable-out

# Connect to cia402
net x-pos-cmd => cia402.0.pos-cmd
net x-pos-fb => cia402.0.pos-fb
net x-enable => cia402.0.enable

# cia402 settings
setp cia402.0.csp-mode 1
setp cia402.0.pos-scale -838860.8

# EtherCAT to cia402 (slave 0)
net x-statusword lcec.0.x.srv-cia-statusword => cia402.0.statusword
net x-opmode-display lcec.0.x.srv-opmode-display => cia402.0.opmode-display
net x-drv-act-pos lcec.0.x.srv-actual-position => cia402.0.drv-actual-position
net x-drv-act-velo lcec.0.x.srv-actual-velocity => cia402.0.drv-actual-velocity

# cia402 to EtherCAT (slave 0)
net x-controlword cia402.0.controlword => lcec.0.x.srv-cia-controlword
net x-modes-of-operation cia402.0.opmode => lcec.0.x.srv-opmode
net x-drv-target-pos cia402.0.drv-target-position => lcec.0.x.srv-target-position
net x-drv-target-velo cia402.0.drv-target-velocity => lcec.0.x.srv-target-velocity

# Fault (M1/M10): cia402.comp derives drv-fault from statusword bit 3 — the
# ONE boolean the twin's "Power/Control" page and /hal red-flagging need to
# stop saying "готов" while the drive is latched Er.E08. joint.N.amp-fault-in
# is a stock LinuxCNC motion pin (exists for every joint regardless of drive
# model); wiring it here is what makes it carry real data instead of its
# always-false default.
net x-fault cia402.0.drv-fault => joint.0.amp-fault-in

# *** AXIS Y (Real IS620N — joint 1, cia402 1, EtherCAT slave 1) ***

# Joint signals
net y-pos-cmd <= joint.1.motor-pos-cmd
net y-pos-fb => joint.1.motor-pos-fb
net y-enable <= joint.1.amp-enable-out

# Connect to cia402
net y-pos-cmd => cia402.1.pos-cmd
net y-pos-fb => cia402.1.pos-fb
net y-enable => cia402.1.enable

# cia402 settings
setp cia402.1.csp-mode 1
setp cia402.1.pos-scale 838860.8

# EtherCAT to cia402 (slave 1)
net y-statusword lcec.0.y.srv-cia-statusword => cia402.1.statusword
net y-opmode-display lcec.0.y.srv-opmode-display => cia402.1.opmode-display
net y-drv-act-pos lcec.0.y.srv-actual-position => cia402.1.drv-actual-position
net y-drv-act-velo lcec.0.y.srv-actual-velocity => cia402.1.drv-actual-velocity

# cia402 to EtherCAT (slave 1)
net y-controlword cia402.1.controlword => lcec.0.y.srv-cia-controlword
net y-modes-of-operation cia402.1.opmode => lcec.0.y.srv-opmode
net y-drv-target-pos cia402.1.drv-target-position => lcec.0.y.srv-target-position
net y-drv-target-velo cia402.1.drv-target-velocity => lcec.0.y.srv-target-velocity

# Fault (M1/M10): cia402.comp derives drv-fault from statusword bit 3 — the
# ONE boolean the twin's "Power/Control" page and /hal red-flagging need to
# stop saying "готов" while the drive is latched Er.E08. joint.N.amp-fault-in
# is a stock LinuxCNC motion pin (exists for every joint regardless of drive
# model); wiring it here is what makes it carry real data instead of its
# always-false default.
net y-fault cia402.1.drv-fault => joint.1.amp-fault-in

# *** AXIS Z (Real IS620N — joint 2, cia402 2, EtherCAT slave 2) ***

# Joint signals
net z-pos-cmd <= joint.2.motor-pos-cmd
net z-pos-fb => joint.2.motor-pos-fb
net z-enable <= joint.2.amp-enable-out

# Connect to cia402
net z-pos-cmd => cia402.2.pos-cmd
net z-pos-fb => cia402.2.pos-fb
net z-enable => cia402.2.enable

# cia402 settings
setp cia402.2.csp-mode 1
setp cia402.2.pos-scale 838860.8

# EtherCAT to cia402 (slave 2)
net z-statusword lcec.0.z.srv-cia-statusword => cia402.2.statusword
net z-opmode-display lcec.0.z.srv-opmode-display => cia402.2.opmode-display
net z-drv-act-pos lcec.0.z.srv-actual-position => cia402.2.drv-actual-position
net z-drv-act-velo lcec.0.z.srv-actual-velocity => cia402.2.drv-actual-velocity

# cia402 to EtherCAT (slave 2)
net z-controlword cia402.2.controlword => lcec.0.z.srv-cia-controlword
net z-modes-of-operation cia402.2.opmode => lcec.0.z.srv-opmode
net z-drv-target-pos cia402.2.drv-target-position => lcec.0.z.srv-target-position
net z-drv-target-velo cia402.2.drv-target-velocity => lcec.0.z.srv-target-velocity

# Fault (M1/M10): cia402.comp derives drv-fault from statusword bit 3 — the
# ONE boolean the twin's "Power/Control" page and /hal red-flagging need to
# stop saying "готов" while the drive is latched Er.E08. joint.N.amp-fault-in
# is a stock LinuxCNC motion pin (exists for every joint regardless of drive
# model); wiring it here is what makes it carry real data instead of its
# always-false default.
net z-fault cia402.2.drv-fault => joint.2.amp-fault-in


# *** 1 kHz telemetry sampler (servo — REAL drive feedback) ***
# Agent reads 15 cols: X/Y/Z × (pos vel torque ferr tpos), raw counts
# from lcec (agent rescales → mm/%). Column order is FROZEN — it is
# read positionally by aicnc_agent.SAMPLER_CHANNELS.
net x-drv-act-pos  => sampler.0.pin.0
net x-drv-act-velo => sampler.0.pin.1
net x-drv-act-trq lcec.0.x.srv-actual-torque => sampler.0.pin.2
net x-drv-ferr lcec.0.x.srv-actual-following-error => sampler.0.pin.3
net x-drv-target-pos => sampler.0.pin.4
net y-drv-act-pos  => sampler.0.pin.5
net y-drv-act-velo => sampler.0.pin.6
net y-drv-act-trq lcec.0.y.srv-actual-torque => sampler.0.pin.7
net y-drv-ferr lcec.0.y.srv-actual-following-error => sampler.0.pin.8
net y-drv-target-pos => sampler.0.pin.9
net z-drv-act-pos  => sampler.0.pin.10
net z-drv-act-velo => sampler.0.pin.11
net z-drv-act-trq lcec.0.z.srv-actual-torque => sampler.0.pin.12
net z-drv-ferr lcec.0.z.srv-actual-following-error => sampler.0.pin.13
net z-drv-target-pos => sampler.0.pin.14

# *** SPINDLE — Wecon VD3E inverter on EtherCAT (CiA-402 velocity) ***
# cia402 instance 3 on bus slave 3, SAME master. M3/M4 enable
# it, M5 stops, S sets speed. The rpm->drive velocity scale (gain) comes from
# the twin's spindle.vel_gain — measured against the drive, never hand-tuned.
#
# The S word enters cia402 through `velocity-cmd` (float IN) — the component
# itself does `drv-target-velocity = velocity-cmd * velo-scale` and drives that
# s32 pin OUT to the bus. Feeding a scale block straight into drv-target-velocity
# is wrong twice over (float into an s32 pin, and writing a component's output);
# that is the type mismatch that killed servo-launch on hardware 01.08.
loadrt scale names=spindle-rps-scale
addf spindle-rps-scale servo-thread

# Разгон/останов — рампой, а не ступенькой. maxv = обороты в секунду:
# max_rpm / ramp_s из двойника; min/max держат команду в конверте шпинделя
# (S больше паспортного не уедет на вал даже из чужой программы).
# Всё в оборотах ШПИНДЕЛЯ — редуктор учтён ниже, в velo-scale, один раз.
loadrt limit2 names=spindle-ramp
addf spindle-ramp servo-thread
setp spindle-ramp.min -20000.0
setp spindle-ramp.max 20000.0
setp spindle-ramp.maxv 6666.666666666667

# csp-mode 0 selects CSV on this cia402.so build — it has NO csv-mode param
# (a `setp ….csv-mode 1` here killed servo-launch: "pin not found", hw 01.08).
setp cia402.3.csp-mode 0
setp cia402.3.pos-scale 1

# Enable on M3/M4 (spindle-on), drop on M5
net spindle-enable spindle.0.on => cia402.3.enable

# S word (rpm ШПИНДЕЛЯ, signed for M3 fwd / M4 rev) -> drive velocity units.
# velo-scale = vel_gain × gear_num/gear_den = 139810.13 × 1/50:
# vel_gain — паспорт ПРИВОДА (единиц команды на 1 об/мин вала СЕРВО, замер на
# боксе), редуктор стоит МЕЖДУ валами и входит множителем, а не пересчётом
# замера. Станок принимает S в оборотах ШПИНДЕЛЯ и крутит вал серво во столько
# раз медленнее, во сколько велит механика (1/1 = прямой привод).
setp cia402.3.velo-scale 2796.2026
net spindle-rpm spindle.0.speed-out => spindle-ramp.in
net spindle-vel-cmd spindle-ramp.out => cia402.3.velocity-cmd

# Feedback: velocity-fb = drv-actual-velocity / velo-scale, i.e. back in rpm —
# в тех же оборотах ШПИНДЕЛЯ, что задавали (тот же множитель на обратном ходе);
# spindle.0.speed-in wants rev/SECOND (core-components manual) -> /60.
setp spindle-rps-scale.gain 0.016666666666666666
net spindle-vel-fb cia402.3.velocity-fb => spindle-rps-scale.in
net spindle-rps spindle-rps-scale.out => spindle.0.speed-in

# EtherCAT <-> cia402 (same shape as the axes, velocity instead of position)
net spindle-statusword lcec.0.s.srv-cia-statusword => cia402.3.statusword
net spindle-opmode-disp lcec.0.s.srv-opmode-display => cia402.3.opmode-display
net spindle-act-velo lcec.0.s.srv-actual-velocity => cia402.3.drv-actual-velocity
# Позиция вала: нужна, чтобы обороты можно было ПОСЧИТАТЬ (прирост counts за
# время), а не только прочитать число, поделённое на тот же vel_gain.
net spindle-act-pos lcec.0.s.srv-actual-position => cia402.3.drv-actual-position
net spindle-controlword cia402.3.controlword => lcec.0.s.srv-cia-controlword
net spindle-opmode cia402.3.opmode => lcec.0.s.srv-opmode
net spindle-target-velo cia402.3.drv-target-velocity => lcec.0.s.srv-target-velocity


# ⚠ кнопка «Стоп» объявлена нормально-разомкнутой (NO): обрыв провода станок не заметит — цепь безопасности ставят на NC-контакт
# *** E-STOP — цепь разрешения приводов ***
# Разрешено = И(все источники). NC-контакт: обрыв провода = останов.
loadrt and2 count=1
loadrt not count=1   # EtherCAT не даёт `-not` сиблинга — инвертируем компонентом
addf and2.0 servo-thread
addf not.0 servo-thread

net estop-ext-inv-raw <= lcec.0.4.din-00
net estop-ext-inv-raw => not.0.in
net estop-ext-inv <= not.0.out

net estop-user <= iocontrol.0.user-enable-out

net estop-user => and2.0.in0
net estop-ext-inv => and2.0.in1
net estop-out <= and2.0.out
net estop-out => iocontrol.0.emc-enable-in

# *** Tool change — ЗАМЫКАНИЕ РУКОПОЖАТИЯ iocontrol ***
# Без этого ЛЮБАЯ программа с M6 висит навсегда: интерпретатор уходит в
# EXEC_WAITING_FOR_IO и ждёт `tool-changed`, которого в headless-конфиге никто
# не даёт. Ровно так встал первый servo-прогон 2026-07-29: task=RUNNING, оси
# проехали 0.4 мм до M6 и замерли — по телеметрии «идёт», по факту стоит.
# Замыкание было только в sim-ветке; остальные конструкторы (parport, lathe,
# laser) держат его в основном HAL — приводим к ним.
#
# У станка с НАСТОЯЩИМ магазином эти две строки переопределяет оверлей наладки
# (там рукопожатие отдаёт железо). Здесь честный смысл: «смена подтверждена
# мгновенно» — на стенде приводов и на станке без ATC это правда.
net tool-change-loop  iocontrol.0.tool-change  => iocontrol.0.tool-changed
net tool-prep-loop    iocontrol.0.tool-prepare => iocontrol.0.tool-prepared

